{
  "name": "aemet-mcp",
  "version": "0.1.0",
  "description": "Servidor MCP para el tiempo oficial de España (API pública OpenData de AEMET). Predicción, observación y avisos como herramientas MCP tipadas.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "aemet",
    "weather",
    "tiempo",
    "meteorologia",
    "spain",
    "claude",
    "cursor"
  ],
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/USER/aemet-mcp.git"
  },
  "homepage": "https://github.com/USER/aemet-mcp#readme",
  "bugs": {
    "url": "https://github.com/USER/aemet-mcp/issues"
  },
  "bin": {
    "aemet-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspector": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
